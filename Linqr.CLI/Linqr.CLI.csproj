<Project Sdk = "Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyVersion></AssemblyVersion>
        <Version>0.0.100</Version>
        <Title>Linqr</Title>
        <Authors>mattpieterse</Authors>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.1.0" />
        <PackageReference Include="Serilog" Version="4.4.1-dev-02443" />
        <PackageReference Include = "Serilog.Extensions.Hosting" Version = "10.0.0" />
        <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
        <PackageReference Include = "Serilog.Sinks.File" Version = "8.0.0-nblumhardt-02322" />
        <PackageReference Include = "Spectre.Console.Cli" Version = "1.0.0-alpha.0.15" />
        <PackageReference Include="Wacton.Unicolour" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update = "logging.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update = "options.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include = "..\Linqr.SDK\Linqr.SDK.csproj" />
    </ItemGroup>

</Project>
